{
  "ConnectionStrings": {
    "Default": "Data Source=/app/data/dockyard.db"
  },
  "Oidc": {
    "ProviderUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "AdminGroup": "",
    "RequireHttpsMetadata": true
  },
  "Dockyard": {
    "DockerSocketPath": "/var/run/docker.sock",
    "SyncIntervalSeconds": 300,
    "AuditRetentionDays": 90,
    "MaxBackupFiles": 7,
    "BackupDirectory": "/app/data/backups"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
